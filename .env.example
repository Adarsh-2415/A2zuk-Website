# ==============================================================================
# A2ZUK — Environment Variables Template (.env.example)
# ==============================================================================
# This file defines placeholder variables for future service integration.
# DO NOT insert real API keys, secrets, or production URLs in this file.
# To configure local development in later phases, copy this file to .env.local:
#   cp .env.example .env.local
#
# NOTE: The Phase 0 verification environment runs completely WITHOUT requiring
# any of these variables. External services are NOT connected in Phase 0.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Publicly accessible client parameters (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Server-only secrets (NEVER prefix with NEXT_PUBLIC_ or expose to client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
VOTE_TOKEN_SECRET=replace-with-32-byte-random-hex-secret
IP_HASH_SALT=replace-with-32-byte-random-hex-salt
CRON_SECRET=replace-with-32-byte-random-hex-cron-secret

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Gmail SMTP 1-Click Moderation (Server-only)
# ------------------------------------------------------------------------------
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-google-app-password
ADMIN_MODERATION_EMAIL=your-email@gmail.com
MODERATION_SECRET=replace-with-32-byte-random-hex-secret

